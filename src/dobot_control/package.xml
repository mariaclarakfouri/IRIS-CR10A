<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dobot_control</name>
  <version>0.0.0</version>
  <description>Controle do braço Dobot via ROS 2</description>
  <maintainer email="clara.trazzi@gmail.com">maria</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>dobot_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>dobot_gui</exec_depend>
  <exec_depend>dobot_twin</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
