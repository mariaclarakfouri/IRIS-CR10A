<?xml version="1.0"?>
<robot name="cr10_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ========================================================
       CR10A — 6 joints, 6 blue accent rings (one per joint)
       Ring placement: child of the CHILD link, at the shaft
       neck visible at each joint interface.
       ======================================================== -->

  <link name="dummy_link"/>

  <!-- ===== base_link ===== -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0017435 -4.7141E-06 0.032774" rpy="0 0 0" />
      <mass value="1.8265" />
      <inertia ixx="0.0041731" ixy="5.9354E-07" ixz="2.52E-05"
               iyy="0.0043128" iyz="-5.4503E-07" izz="0.0067702" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/base_link.STL"/></geometry>
      <material name="body_gray"><color rgba="0.800 0.800 0.800 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/base_link.STL"/></geometry>
    </collision>
  </link>

  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <origin xyz="0 0 0.03" rpy="0 0 0" />
    <parent link="world" />
    <child link="dummy_link" />
  </joint>
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy_link" />
    <child link="base_link" />
  </joint>

  <!-- ===== Link1 — shoulder housing ===== -->
  <!-- Link1 mesh neck radii:
         Z=-0.083 (joint1 groove): r_max=0.077 m
         Z=+0.087 (joint2 groove): r_max=0.073 m               -->
  <link name="Link1">
    <inertial>
      <origin xyz="-1.6635E-06 -0.010819 0.0028389" rpy="0 0 0" />
      <mass value="4.1649" />
      <inertia ixx="0.020714" ixy="-1.9343E-07" ixz="1.6036E-07"
               iyy="0.018824" iyz="-9.6731E-05" izz="0.014575" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/Link1.STL"/></geometry>
      <material name="body_gray"><color rgba="0.800 0.800 0.800 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/Link1.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.1765" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Link1" />
    <axis xyz="0 0 -1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <!-- JOINT 1 ring — at the bottom neck of Link1 shoulder housing (Z=-0.083).
       Mesh outer radius at this section = 0.077 m → ring at 0.083 m             -->
  <link name="ring_j1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0830" length="0.0140"/></geometry>
      <material name="dobot_blue"><color rgba="0.157 0.290 0.690 1"/></material>
    </visual>
  </link>
  <joint name="joint_ring_j1" type="fixed">
    <origin xyz="0 0 -0.0830" rpy="0 0 0"/>
    <parent link="Link1"/>
    <child link="ring_j1"/>
  </joint>
  <link name="cap_j1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0890" length="0.0060"/></geometry>
      <material name="joint_white"><color rgba="0.900 0.900 0.900 1"/></material>
    </visual>
  </link>
  <joint name="joint_cap_j1" type="fixed">
    <origin xyz="0 0 -0.0760" rpy="0 0 0"/>
    <parent link="Link1"/>
    <child link="cap_j1"/>
  </joint>

  <!-- JOINT 2 ring — at the top neck of Link1 shoulder housing (Z=+0.087).
       Mesh outer radius at this section = 0.073 m → ring at 0.079 m             -->
  <link name="ring_j2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0790" length="0.0140"/></geometry>
      <material name="dobot_blue"><color rgba="0.157 0.290 0.690 1"/></material>
    </visual>
  </link>
  <joint name="joint_ring_j2" type="fixed">
    <origin xyz="0 0 0.0870" rpy="0 0 0"/>
    <parent link="Link1"/>
    <child link="ring_j2"/>
  </joint>
  <link name="cap_j2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0850" length="0.0060"/></geometry>
      <material name="joint_white"><color rgba="0.900 0.900 0.900 1"/></material>
    </visual>
  </link>
  <joint name="joint_cap_j2" type="fixed">
    <origin xyz="0 0 0.0810" rpy="0 0 0"/>
    <parent link="Link1"/>
    <child link="cap_j2"/>
  </joint>

  <!-- ===== Link2 — upper arm ===== -->
  <!-- Link2 arm tube runs along X. Tube center is offset Z=+0.193 from link origin.
       Joint3 is at X=-0.607 in Link2 frame. Ring placed at the end of the arm tube
       (X=-0.555, Z=0.193) just before the elbow housing begins.                  -->
  <link name="Link2"><!-- joint1 keeps axis -1 -->
    <inertial>
      <origin xyz="-0.24631 3.5816E-07 0.19515" rpy="0 0 0" />
      <mass value="11.314" />
      <inertia ixx="0.033616" ixy="-8.2998E-07" ixz="-0.0033352"
               iyy="0.30683" iyz="-6.6457E-08" izz="0.29972" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/cr10/Link2.STL"  />
      </geometry>
      <material name="body_gray"><color rgba="0.800 0.800 0.800 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/Link2.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 1.5708 0" />
    <parent link="Link1" />
    <child link="Link2" />
    <axis xyz="0 0 1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <!-- JOINT 3 ring — at elbow end of Link2 arm tube.
       Arm tube center at X=-0.555: (Y=0, Z=0.193). Tube r≈60 mm → ring at 70 mm.
       Cylinder axis along X (rpy 0 π/2 0).                                       -->
  <link name="ring_j3">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0700" length="0.0140"/></geometry>
      <material name="dobot_blue"><color rgba="0.157 0.290 0.690 1"/></material>
    </visual>
  </link>
  <joint name="joint_ring_j3" type="fixed">
    <origin xyz="-0.5550 0 0.1930" rpy="0 0 0"/>
    <parent link="Link2"/>
    <child link="ring_j3"/>
  </joint>
  <link name="cap_j3">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.0760" length="0.0060"/></geometry>
      <material name="joint_white"><color rgba="0.900 0.900 0.900 1"/></material>
    </visual>
  </link>
  <joint name="joint_cap_j3" type="fixed">
    <origin xyz="-0.5490 0 0.1930" rpy="0 0 0"/>
    <parent link="Link2"/>
    <child link="cap_j3"/>
  </joint>

  <!-- ===== Link3 — forearm ===== -->
  <link name="Link3">
    <inertial>
      <origin xyz="-0.270855859955203 2.5144690851208E-07 0.0622960395387155" rpy="0 0 0" />
      <mass value="4.89191189064363" />
      <inertia ixx="0.00715720724136357" ixy="-5.62017408817872E-07" ixz="-0.00257748068989916"
               iyy="0.239673426443838" iyz="9.26228295895878E-08" izz="0.238369168055991" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/cr10/Link3.STL"  />
      </geometry>
      <material name="body_gray"><color rgba="0.800 0.800 0.800 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/Link3.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="-0.607 0 0" rpy="0 0 0" />
    <parent link="Link2" />
    <child link="Link3" />
    <axis xyz="0 0 1" />
    <limit lower="-2.861" upper="2.861" effort="300" velocity="100" />
  </joint>

  <!-- ===== Link4 — wrist roll ===== -->
  <!-- Link4 bottom neck (joint4 shaft entry) at Z=-0.060.
       Mesh r_max at neck = 0.046 m → ring at 0.053 m                            -->
  <link name="Link4">
    <inertial>
      <origin xyz="-2.53137491438456E-07 0.00798724498566683 -0.00589074229668524" rpy="0 0 0" />
      <mass value="1.16884294495796" />
      <inertia ixx="0.00292614933092813" ixy="8.20440076221281E-09" ixz="-8.19990423351321E-09"
               iyy="0.00150052997722543" iyz="-5.4492521866877E-05" izz="0.00273274943535585" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/cr10/Link4.STL"/>
      </geometry>
      <material name="body_gray"><color rgba="0.800 0.800 0.800 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/Link4.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="-0.568 0 0.191" rpy="0 0 -1.5708" />
    <parent link="Link3" />
    <child link="Link4" />
    <axis xyz="0 0 1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <!-- JOINT 4 ring — bottom neck of Link4 (where the joint4 shaft enters the wrist housing) -->
  <link name="ring_j4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0530" length="0.0130"/></geometry>
      <material name="dobot_blue"><color rgba="0.157 0.290 0.690 1"/></material>
    </visual>
  </link>
  <joint name="joint_ring_j4" type="fixed">
    <origin xyz="0 0 -0.0600" rpy="0 0 0"/>
    <parent link="Link4"/>
    <child link="ring_j4"/>
  </joint>
  <link name="cap_j4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0590" length="0.0060"/></geometry>
      <material name="joint_white"><color rgba="0.900 0.900 0.900 1"/></material>
    </visual>
  </link>
  <joint name="joint_cap_j4" type="fixed">
    <origin xyz="0 0 -0.0530" rpy="0 0 0"/>
    <parent link="Link4"/>
    <child link="cap_j4"/>
  </joint>

  <!-- ===== Link5 — wrist pitch ===== -->
  <!-- Link5 bottom neck at Z=-0.057. Mesh r_max = 0.046 m → ring at 0.053 m    -->
  <link name="Link5">
    <inertial>
      <origin xyz="5.50699455951951E-07 -0.0145467578029201 -0.00454887087411437" rpy="0 0 0" />
      <mass value="1.22303084244711" />
      <inertia ixx="0.00337905462069531" ixy="3.57819902464362E-08" ixz="-7.51828060542842E-09"
               iyy="0.00149255573951137" iyz="8.41917918947542E-05" izz="0.00323300312341709" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/cr10/Link5.STL" />
      </geometry>
      <material name="body_gray"><color rgba="0.800 0.800 0.800 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/Link5.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0 -0.125 0" rpy="1.5708 0 0" />
    <parent link="Link4" />
    <child link="Link5" />
    <axis xyz="0 0 1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <!-- JOINT 5 ring — bottom neck of Link5 -->
  <link name="ring_j5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0530" length="0.0130"/></geometry>
      <material name="dobot_blue"><color rgba="0.157 0.290 0.690 1"/></material>
    </visual>
  </link>
  <joint name="joint_ring_j5" type="fixed">
    <origin xyz="0 0 -0.0570" rpy="0 0 0"/>
    <parent link="Link5"/>
    <child link="ring_j5"/>
  </joint>
  <link name="cap_j5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0590" length="0.0060"/></geometry>
      <material name="joint_white"><color rgba="0.900 0.900 0.900 1"/></material>
    </visual>
  </link>
  <joint name="joint_cap_j5" type="fixed">
    <origin xyz="0 0 -0.0500" rpy="0 0 0"/>
    <parent link="Link5"/>
    <child link="cap_j5"/>
  </joint>

  <!-- ===== Link6 — flange ===== -->
  <!-- Link6 shaft at Z=-0.030. Mesh r_max = 0.055 m → ring at 0.060 m          -->
  <link name="Link6">
    <inertial>
      <origin xyz="1.42987471244488E-10 2.29640694859867E-05 -0.0205297780389956" rpy="0 0 0" />
      <mass value="0.205439548775225" />
      <inertia ixx="0.000110115425573789" ixy="-8.21487875808426E-14" ixz="4.28615843947113E-14"
               iyy="0.000110662465957898" iyz="3.68879932665237E-08" izz="0.00020518429573024" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/cr10/Link6.STL" />
      </geometry>
      <material name="body_gray"><color rgba="0.800 0.800 0.800 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find dobot_twin)/meshes/cr10/Link6.STL"/></geometry>
    </collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0 0.1084 0" rpy="-1.5708 0 0" />
    <parent link="Link5" />
    <child link="Link6" />
    <axis xyz="0 0 1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <!-- JOINT 6 ring — on the Link6 shaft -->
  <link name="ring_j6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0600" length="0.0120"/></geometry>
      <material name="dobot_blue"><color rgba="0.157 0.290 0.690 1"/></material>
    </visual>
  </link>
  <joint name="joint_ring_j6" type="fixed">
    <origin xyz="0 0 -0.0300" rpy="0 0 0"/>
    <parent link="Link6"/>
    <child link="ring_j6"/>
  </joint>
  <link name="cap_j6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0660" length="0.0060"/></geometry>
      <material name="joint_white"><color rgba="0.900 0.900 0.900 1"/></material>
    </visual>
  </link>
  <joint name="joint_cap_j6" type="fixed">
    <origin xyz="0 0 -0.0230" rpy="0 0 0"/>
    <parent link="Link6"/>
    <child link="cap_j6"/>
  </joint>

  <!-- ===== Gazebo material overrides — body links ===== -->
  <gazebo reference="base_link">
    <gravity>false</gravity><selfCollide>true</selfCollide>
    <visual><material>
      <ambient>0.900 0.900 0.900 1</ambient>
      <diffuse>0.745 0.745 0.745 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="Link1">
    <gravity>false</gravity><selfCollide>true</selfCollide>
    <visual><material>
      <ambient>0.900 0.900 0.900 1</ambient>
      <diffuse>0.745 0.745 0.745 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="Link2">
    <gravity>false</gravity><selfCollide>true</selfCollide>
    <visual><material>
      <ambient>0.900 0.900 0.900 1</ambient>
      <diffuse>0.745 0.745 0.745 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="Link3">
    <gravity>false</gravity><selfCollide>true</selfCollide>
    <visual><material>
      <ambient>0.900 0.900 0.900 1</ambient>
      <diffuse>0.745 0.745 0.745 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="Link4">
    <gravity>false</gravity><selfCollide>true</selfCollide>
    <visual><material>
      <ambient>0.900 0.900 0.900 1</ambient>
      <diffuse>0.745 0.745 0.745 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="Link5">
    <gravity>false</gravity><selfCollide>true</selfCollide>
    <visual><material>
      <ambient>0.900 0.900 0.900 1</ambient>
      <diffuse>0.745 0.745 0.745 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="Link6">
    <gravity>false</gravity><selfCollide>true</selfCollide>
    <visual><material>
      <ambient>0.900 0.900 0.900 1</ambient>
      <diffuse>0.745 0.745 0.745 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
    </material></visual>
  </gazebo>

  <!-- ===== Gazebo material overrides — blue rings ===== -->
  <gazebo reference="ring_j1">
    <visual><material>
      <ambient>0.157 0.290 0.690 1</ambient>
      <diffuse>0.157 0.290 0.690 1</diffuse>
      <specular>0.10 0.15 0.40 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="ring_j2">
    <visual><material>
      <ambient>0.157 0.290 0.690 1</ambient>
      <diffuse>0.157 0.290 0.690 1</diffuse>
      <specular>0.10 0.15 0.40 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="ring_j3">
    <visual><material>
      <ambient>0.157 0.290 0.690 1</ambient>
      <diffuse>0.157 0.290 0.690 1</diffuse>
      <specular>0.10 0.15 0.40 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="ring_j4">
    <visual><material>
      <ambient>0.157 0.290 0.690 1</ambient>
      <diffuse>0.157 0.290 0.690 1</diffuse>
      <specular>0.10 0.15 0.40 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="ring_j5">
    <visual><material>
      <ambient>0.157 0.290 0.690 1</ambient>
      <diffuse>0.157 0.290 0.690 1</diffuse>
      <specular>0.10 0.15 0.40 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="ring_j6">
    <visual><material>
      <ambient>0.157 0.290 0.690 1</ambient>
      <diffuse>0.157 0.290 0.690 1</diffuse>
      <specular>0.10 0.15 0.40 1</specular>
    </material></visual>
  </gazebo>

  <!-- ===== Gazebo material overrides — white caps ===== -->
  <gazebo reference="cap_j1">
    <visual><material>
      <ambient>0.950 0.950 0.950 1</ambient>
      <diffuse>0.900 0.900 0.900 1</diffuse>
      <specular>0.50 0.50 0.50 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="cap_j2">
    <visual><material>
      <ambient>0.950 0.950 0.950 1</ambient>
      <diffuse>0.900 0.900 0.900 1</diffuse>
      <specular>0.50 0.50 0.50 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="cap_j3">
    <visual><material>
      <ambient>0.950 0.950 0.950 1</ambient>
      <diffuse>0.900 0.900 0.900 1</diffuse>
      <specular>0.50 0.50 0.50 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="cap_j4">
    <visual><material>
      <ambient>0.950 0.950 0.950 1</ambient>
      <diffuse>0.900 0.900 0.900 1</diffuse>
      <specular>0.50 0.50 0.50 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="cap_j5">
    <visual><material>
      <ambient>0.950 0.950 0.950 1</ambient>
      <diffuse>0.900 0.900 0.900 1</diffuse>
      <specular>0.50 0.50 0.50 1</specular>
    </material></visual>
  </gazebo>
  <gazebo reference="cap_j6">
    <visual><material>
      <ambient>0.950 0.950 0.950 1</ambient>
      <diffuse>0.900 0.900 0.900 1</diffuse>
      <specular>0.50 0.50 0.50 1</specular>
    </material></visual>
  </gazebo>

  <!-- 在运行demo.launch.py时，需要注释这个ros2_control节点 -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint1">
      <!-- min/max removidos: eram placeholders ±1 rad do fork Dobot e
           CLAMPAVAM o comando — joint3 (home −2,094) e joint5 (home
           +1,571) ficam fora de [−1,1]. Sem os params, o gazebo_ros2_control
           usa os <limit> reais da junta (±6,27; joint3 ±2,861). -->
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.7854</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <!-- min/max removidos: eram placeholders ±1 rad do fork Dobot e
           CLAMPAVAM o comando — joint3 (home −2,094) e joint5 (home
           +1,571) ficam fora de [−1,1]. Sem os params, o gazebo_ros2_control
           usa os <limit> reais da junta (±6,27; joint3 ±2,861). -->
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.5236</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <!-- min/max removidos: eram placeholders ±1 rad do fork Dobot e
           CLAMPAVAM o comando — joint3 (home −2,094) e joint5 (home
           +1,571) ficam fora de [−1,1]. Sem os params, o gazebo_ros2_control
           usa os <limit> reais da junta (±6,27; joint3 ±2,861). -->
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-2.0944</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <!-- min/max removidos: eram placeholders ±1 rad do fork Dobot e
           CLAMPAVAM o comando — joint3 (home −2,094) e joint5 (home
           +1,571) ficam fora de [−1,1]. Sem os params, o gazebo_ros2_control
           usa os <limit> reais da junta (±6,27; joint3 ±2,861). -->
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <!-- min/max removidos: eram placeholders ±1 rad do fork Dobot e
           CLAMPAVAM o comando — joint3 (home −2,094) e joint5 (home
           +1,571) ficam fora de [−1,1]. Sem os params, o gazebo_ros2_control
           usa os <limit> reais da junta (±6,27; joint3 ±2,861). -->
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <!-- min/max removidos: eram placeholders ±1 rad do fork Dobot e
           CLAMPAVAM o comando — joint3 (home −2,094) e joint5 (home
           +1,571) ficam fora de [−1,1]. Sem os params, o gazebo_ros2_control
           usa os <limit> reais da junta (±6,27; joint3 ±2,861). -->
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find dobot_twin)/config/ros2_controllers.yaml</parameters>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>


  <!-- ========================================================
       CÉLULA DE CARGA FA7155 COM A PONTEIRA (só nesta versão "com célula")
       Do flange (Link6) para fora: flange fixo de alumínio, célula FA7155 de
       6 eixos, acoplador hot-swap e ponteira F (face de contato a 67,7 mm do
       flange; 0,3837 kg no total). Links, juntas, massas, malhas e o sensor de
       força simulado copiados do touch_tool_tcp.urdf do projeto cr10twin
       (src/touch_pack/urdf), sem alteração além do caminho das malhas e do
       tópico do sensor simulado (/sim/celula/wrench). Os comentários abaixo
       são os do arquivo original.
       ======================================================== -->
  <!-- Azul do filamento: todas as peças impressas saíram na mesma cor. -->
  <material name="printed_blue">
    <color rgba="0.11 0.35 0.78 1.0"/>
  </material>
  <!-- Aço niquelado da viga S. -->
  <material name="steel_grey">
    <color rgba="0.62 0.63 0.65 1.0"/>
  </material>

  <!-- ══════════════════════════════════════════════════════════════════
       FLANGE FIXO DO FA7155 — cad/step/FA7155 固定端法兰（需另购）.STEP
       Disco de alumínio ⌀75 × 6 mm que parafusa DIRETO na face do flange do
       CR10 (manual §2.1: quatro M6 + pino Φ6). É a peça comprada à parte que
       torna o `acoplador_robo` desnecessário — a pilha da viga S precisava
       dele para adaptar o punho ao rosqueado M12, esta não.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="ft_flange_link">
    <inertial>
      <origin xyz="0.00018 0.00010 0.00295" rpy="0 0 0"/>
      <mass value="0.0518"/>
      <inertia ixx="2.149e-05" ixy="-1.491e-07" ixz="-4.657e-10"
               iyy="2.224e-05" iyz="-2.689e-10" izz="4.341e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/celula/fa7155_flange_fixo.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="steel_grey"/>
    </visual>
    <collision name="col_ft_flange">
      <origin xyz="0 0 0.003" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0375" length="0.006"/></geometry>
    </collision>
  </link>

  <joint name="ft_flange_attach" type="fixed">
    <parent link="Link6"/>
    <child link="ft_flange_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       CÉLULA FA7155 DE 6 EIXOS — cad/step/FA7155D_20Nm.step
       Corpo de alumínio ⌀75 × 36,5 mm que mede as SEIS componentes do wrench
       (Fx Fy Fz Mx My Mz) e as entrega por RS485 — nada aqui converte sinal,
       ver ft_serial.py. A massa é a do CATÁLOGO (300 g) e não a integrada da
       geometria: o STEP é o envelope externo, sem a eletrônica interna, e
       integrá-lo daria 2077 kg/m³ de densidade aparente.
       O saliente em +X (bbox vai a 44 mm) é o conector do cabo; a colisão é
       cilíndrica e o ignora, porque ele não é superfície de contato.
       Colisão só do trecho EXPOSTO: os 5,6 mm de baixo ficam no flange fixo.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="load_cell_link">
    <inertial>
      <origin xyz="0.00010 0.00008 0.01933" rpy="0 0 0"/>
      <mass value="0.3000"/>
      <inertia ixx="1.233e-04" ixy="2.380e-09" ixz="-2.932e-07"
               iyy="1.258e-04" iyz="2.405e-07" izz="2.059e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/celula/fa7155_sensor.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="steel_grey"/>
    </visual>
    <collision name="col_load_cell">
      <origin xyz="0 0 0.02105" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0375" length="0.0309"/></geometry>
    </collision>
  </link>

  <joint name="load_cell_attach" type="fixed">
    <parent link="ft_flange_link"/>
    <child link="load_cell_link"/>
    <origin xyz="0 0 0.0004" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       ACOPLADOR HOT-SWAP — cad/step/acoplador_celula_hotswap.step
       Disco impresso ⌀66 × 10 mm na face móvel da célula, seguido de uma
       haste ⌀15 × 12 mm onde a ponteira encaixa. É o par do `acoplador_tool`
       da pilha antiga, mas MUITO mais curto: é aqui e no corpo do touch_tool
       (que sumiu) que estão os 94,5 mm de diferença de TCP.
       Colisão do disco + do trecho de haste que sobra antes da ponteira.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="coupler_tool_link">
    <inertial>
      <origin xyz="0.00000 -0.00000 0.00484" rpy="0 0 0"/>
      <mass value="0.0275"/>
      <inertia ixx="7.242e-06" ixy="-3.037e-22" ixz="-1.493e-23"
               iyy="7.546e-06" iyz="-5.549e-23" izz="1.416e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/celula/acoplador_celula_hotswap.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="printed_blue"/>
    </visual>
    <collision name="col_coupler_disc">
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry><cylinder radius="0.033" length="0.010"/></geometry>
    </collision>
    <collision name="col_coupler_stem">
      <origin xyz="0 0 0.01125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0075" length="0.0025"/></geometry>
    </collision>
  </link>

  <joint name="coupler_tool_attach" type="fixed">
    <parent link="load_cell_link"/>
    <child link="coupler_tool_link"/>
    <origin xyz="0 0 0.0368" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       PONTEIRA F — cad/step/ponteira_F_retangular_15x17.step
       Corpo 20 × 20 mm com um soquete interno que desce sobre a haste do
       acoplador, afinando no topo até a FACE DE CONTATO de 15 × 17 mm. É a
       peça hot-swap: trocar de ponteira muda a altura do TCP.
       Não há laminado tátil 5×5 nesta pilha — aquele foi desenhado para a
       cabeça 22,4 × 24,9 da ponteira D, que não entra aqui.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="tool_tip_link">
    <inertial>
      <origin xyz="0.00000 0.00000 0.00990" rpy="0 0 0"/>
      <mass value="0.0043"/>
      <inertia ixx="2.429e-07" ixy="1.706e-09" ixz="-1.740e-18"
               iyy="2.328e-07" iyz="-1.404e-21" izz="2.484e-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find dobot_twin)/meshes/celula/ponteira_F_retangular_15x17.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="printed_blue"/>
    </visual>
    <collision name="col_tip_body">
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry><box size="0.020 0.020 0.016"/></geometry>
    </collision>
    <!-- Face de 15 x 17: é ESTA caixa que toca a peça. -->
    <collision name="col_tip_face">
      <origin xyz="0 0 0.017" rpy="0 0 0"/>
      <geometry><box size="0.0150 0.0170 0.0020"/></geometry>
    </collision>
  </link>

  <joint name="tool_tip_attach" type="fixed">
    <parent link="coupler_tool_link"/>
    <child link="tool_tip_link"/>
    <origin xyz="0 0 0.0125" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       tcp_link — face de contato da ponteira F, Z = +67,7 mm do flange.
       Soma da cadeia: 0 + 0,4 + 36,8 + 12,5 + 18,0 = 67,7 mm.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="tcp_link"/>

  <joint name="tcp_alias_joint" type="fixed">
    <parent link="tool_tip_link"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.018" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       PROPRIEDADES GAZEBO (ODE)
       Em Gazebo Classic a cor declarada no material do link nem sempre
       renderiza; o override ambient/diffuse/specular no bloco gazebo
       reference abaixo é o que efetivamente colore a peça.

       NB: nada de sintaxe de tag dentro de comentário aqui. O launch monta o
       URDF mínimo do robot_state_publisher removendo visual/collision/
       inertial por regex, e um nome de tag solto no meio de um comentário
       faz a regex casar através dele e comer o fechamento do link.
  ══════════════════════════════════════════════════════════════════ -->
  <gazebo reference="Link6">
    <self_collide>0</self_collide>
  </gazebo>

  <gazebo reference="ft_flange_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.40</mu1><mu2>0.40</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.40 0.41 0.43 1</ambient>
      <diffuse>0.62 0.63 0.65 1</diffuse>
      <specular>0.85 0.85 0.90 1</specular>
    </material></visual>
  </gazebo>

  <gazebo reference="load_cell_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.40</mu1><mu2>0.40</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.40 0.41 0.43 1</ambient>
      <diffuse>0.62 0.63 0.65 1</diffuse>
      <specular>0.85 0.85 0.90 1</specular>
    </material></visual>
  </gazebo>

  <gazebo reference="coupler_tool_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.40</mu1><mu2>0.40</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.06 0.20 0.45 1</ambient>
      <diffuse>0.11 0.35 0.78 1</diffuse>
      <specular>0.25 0.25 0.30 1</specular>
    </material></visual>
  </gazebo>

  <!-- Ponteira: atrito mais alto — é a superfície que desliza sobre a peça.
       kp/minDepth são os VALORES DA BASELINE (as coletas boas de 29–31/08).
       f934d4e ("ports") os endureceu para 1e6 / 0,05 mm com o argumento de
       que a compliância do ensaio deve vir da mola da amostra, não do
       contato — argumento correto, mas ele entrou no mesmo commit que
       quebrou a descida e volta junto com o resto da baseline.
       Ao re-endurecer: mexer NESTES dois isolado dos de research_lab.world,
       e conferir o pico do primeiro impacto (impact_peak_n) — contato mais
       rígido multiplica o pico à mesma velocidade de toque. -->
  <gazebo reference="tool_tip_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.60</mu1><mu2>0.60</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.06 0.20 0.45 1</ambient>
      <diffuse>0.11 0.35 0.78 1</diffuse>
      <specular>0.25 0.25 0.30 1</specular>
    </material></visual>
  </gazebo>

  <!-- ══════════════════════════════════════════════════════════════════
       F/T SIMULADA na junta onde a célula axial real está montada.
       `disableFixedJointLumping` preserva a junta na conversão URDF→SDF
       (sem isso ela some e o plugin não acha `load_cell_attach`).
       `provideFeedback` liga o wrench de restrição da junta.
       O plugin publica geometry_msgs/WrenchStamped em /sim/celula/wrench;
       o nó `sim_force_bridge` converte force.z → /load_cell/force_net
       (compressão positiva), fechando a malha de força NO SIM.

       CUSTO, e por isso os dois blocos abaixo são REMOVIDOS pelo launch
       quando force_source != 'sim' (ver _build_touch_tool_suffix):
       preservar a junta tira do lumping os 331,8 g abaixo dela
       (load_cell 300,0 + coupler_tool 27,5 + tip 4,3), com CoM a ~24 mm do
       punho — bem menos braço de alavanca que os ~100 mm da pilha da viga S,
       mas a restrição elástica continua sendo elástica. O que era UM corpo rígido vira dois
       ligados por uma restrição que o ODE resolve iterativamente — ou seja,
       elástica. É massa pendurada exatamente onde J4 trabalha, e a coleta
       20260901_094646 mostrou J4 ultrapassando o home em 1,25° e oscilando
       sozinha enquanto J2/J3 estavam congeladas.

       Com force_source=real (o default, e o que os ensaios usam) nada se
       perde: a força vem da célula física.
  ══════════════════════════════════════════════════════════════════ -->
  <gazebo reference="load_cell_attach">
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <provideFeedback>true</provideFeedback>
  </gazebo>

  <gazebo>
    <plugin name="sim_load_cell_ft" filename="libgazebo_ros_ft_sensor.so">
      <ros>
        <namespace>/</namespace>
        <remapping>wrench:=/sim/celula/wrench</remapping>
      </ros>
      <joint_name>load_cell_attach</joint_name>
      <update_rate>80.0</update_rate>
      <gaussian_noise>0.02</gaussian_noise>
    </plugin>
  </gazebo>

</robot>
