# Goal: move a face da ponteira em LINHA RETA, mantendo a orientação da
# ferramenta. Coordenadas no frame do robô (origem no centro da base, na
# superfície onde ele está parafusado; x para a frente, z para cima).
float64[3] deslocamento_mm
# Ou: subir/descer na vertical ATÉ a altura `altura_mm` (z da face da
# ponteira no frame do robô; o tampo da mesa do modelo de segurança é z = 0).
# Com ate_altura, deslocamento_mm é ignorado.
bool ate_altura
float64 altura_mm
float64 velocidade_mms
# Para sozinho quando a força da célula mudar mais que `limiar_n` em relação
# ao começo do movimento (só com a célula de carga na ponta).
bool parar_no_contato
float64 limiar_n
# Deixa a ponteira chegar até a mesa (a verificação de segurança deixa a
# ponteira, e só ela, passar da margem até a mesa). Descendo, exige
# parar_no_contato; subindo na vertical (saindo da mesa), não.
bool tocar_mesa
---
# Result
bool success
string message
bool contato
float64 percorrido_mm
float64[6] juntas
float64[3] ponta_mm
float64 forca_n
---
# Feedback
string status
float64 percorrido_mm
float64 forca_n
